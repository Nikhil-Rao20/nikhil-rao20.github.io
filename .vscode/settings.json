{
  // node_modules is ~97MB and dist is regenerated by every build. Neither is
  // tracked by git (see .gitignore), but VS Code still searches and watches
  // them unless told otherwise, which is slow and floods search results.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/package-lock.json": true
  },

  // Keeps the file watcher off ~100MB of dependencies. This is the setting
  // that stops VS Code churning CPU in the background on this repo.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true
  },

  // Uncomment to hide them from the Explorer tree as well. Left off by default
  // so dependency source is still browsable when debugging a package.
  // "files.exclude": {
  //   "**/node_modules": true,
  //   "**/dist": true
  // },

  "typescript.tsdk": "node_modules/typescript/lib"
}
